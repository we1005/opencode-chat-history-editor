# 后端端口
PORT=9001

# 数据库路径 (留空则自动检测: Windows: %USERPROFILE%\.local\share\opencode\opencode.db)
DB_PATH=

# 差异文件存储路径 (留空则自动检测: ~/.local/share/opencode/storage/session_diff)
# 通常不需要修改，除非 OpenCode 的 storage 目录位置不同
DIFF_STORAGE_PATH=

# 编辑消息通过官方 API 写入；服务必须使用上面数据库所属的 OpenCode 数据目录
OPENCODE_SERVER_URL=http://127.0.0.1:4096
# 设置了服务端密码时填写（默认用户名 opencode）
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# 原文备份目录（留空使用 ~/.local/state/opencode-message-editor/backups）
EDITOR_BACKUP_DIR=
HOST=127.0.0.1
